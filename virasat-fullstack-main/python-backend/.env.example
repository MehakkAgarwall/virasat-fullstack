# ==========================================
# Kala Trail Backend Environment Configuration
# ==========================================

# Port (Cloud deployment platform injects this dynamically, e.g. Railway/Render)
PORT=8000

# CORS: comma-separated list of allowed origins or "*" for all
ALLOWED_ORIGINS=http://localhost:5173,https://virasat-frontend.vercel.app

# Database Configuration (Option 1: Individual variables)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kalatrail

# Database Configuration (Option 2: Cloud connection URL e.g. Railway/Render)
# DATABASE_URL=mysql://root:password@host:3306/kalatrail
# MYSQL_URL=mysql://root:password@host:3306/kalatrail

# Google Gemini API Configuration (Primary AI Provider)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenAI-Compatible Fallback Configuration (Used when GEMINI_API_KEY is not set)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
VOICE_ASSISTANT_OPENAI_MODEL=gpt-5-mini

# OpenRouteService API Key (For driving route calculations)
# Obtain from https://openrouteservice.org/
ORS_API_KEY=

# Groq API Key (Optional: for bulk offline craft enrichment)
# Obtain from https://console.groq.com/
GROQ_API_KEY=

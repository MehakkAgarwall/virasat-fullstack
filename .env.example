# Copy this file to .env and fill in real values. Never commit .env itself.

# Local MySQL connection details
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=kalatrail

# Routing API (pick one)
# OpenRouteService: free tier, sign up at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your_openrouteservice_key_here

# LLM API for generating friendly craft descriptions
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER=anthropic
